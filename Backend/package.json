{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express API for Support Issue Tracker",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:check": "node --env-file-if-exists=.env src/scripts/check-db.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/*.test.js"
  },
  "keywords": [],
  "author": "",
